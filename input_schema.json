{
  "title": "arXiv Intelligence MCP",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "tool": {
      "title": "Tool Name",
      "type": "string",
      "description": "MCP tool to call",
      "enum": ["search_papers", "get_paper_details", "get_author_profile", "track_citations", "get_trending_papers"],
      "editor": "select",
      "prefill": "search_papers"
    },
    "params": {
      "title": "Parameters (JSON)",
      "type": "object",
      "description": "Tool parameters as JSON object",
      "editor": "json",
      "prefill": {"query": "transformer attention", "maxResults": 10}
    }
  }
}
